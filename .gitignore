# =============================================================================
# Arc Quest - Minecraft Forge Mod .gitignore
# =============================================================================

# -----------------------------------------------------------------------------
# IDE & Editor Files
# -----------------------------------------------------------------------------

# IntelliJ IDEA
.idea/
*.iml
*.ipr
*.iws
out/
.idea_modules/
atlassian-ide-plugin.xml

# Eclipse
.classpath
.project
.settings/
bin/

# VS Code
.vscode/settings.json
.vscode/launch.json
.vscode/tasks.json
.code-workspace

# NetBeans
nbproject/private/
nbbuild/
dist/
nbdist/
.nb-gradle/

# -----------------------------------------------------------------------------
# Build & Compilation
# -----------------------------------------------------------------------------

# Gradle
.gradle/
build/
**/build/
gradle-app.setting
.gradletasknamecache
!gradle-wrapper.jar

# Compiled files
*.class
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# -----------------------------------------------------------------------------
# Runtime & Generated Data
# -----------------------------------------------------------------------------

# Minecraft runtime directories
run/
runs/
run-data/

# Lingma AI configuration and skills
.lingma/

# Generated resources (Data Generator output)
src/generated/resources/

# -----------------------------------------------------------------------------
# Logs & Debug Files
# -----------------------------------------------------------------------------

# Log files
*.log
*.log.gz
logs/
run/logs/
run-data/logs/

# Crash reports
crash-reports/
run/crash-reports/
run-data/crash-reports/

# Debug output files
compile_output.txt
compile_error.txt
build_output.txt
build_log.txt
error.log

# -----------------------------------------------------------------------------
# OS-Specific Files
# -----------------------------------------------------------------------------

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/
*.stackdump
*.lnk

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# Linux
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

# -----------------------------------------------------------------------------
# Test Files
# -----------------------------------------------------------------------------

# Unit tests (test code should typically be committed, but exclude if desired)
src/test/

# -----------------------------------------------------------------------------
# Temporary & Cache Files
# -----------------------------------------------------------------------------

# Java crash logs
hs_err_pid*
replay_pid*

# Package manager caches
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python (if used for scripts)
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/

# -----------------------------------------------------------------------------
# Documentation & Notes (Optional - uncomment if needed)
# -----------------------------------------------------------------------------

# Personal notes (keep project docs)
# *.md
# TODO.md
# NOTES.md

# -----------------------------------------------------------------------------
# Sensitive Data (NEVER commit these!)
# -----------------------------------------------------------------------------

# Environment variables
.env
.env.local
.env.*.local

# Credentials
*.pem
*.key
*.p12
*.keystore

# API keys & secrets
secrets/
credentials/

# -----------------------------------------------------------------------------
