# -----------------------------------------------------------------------------

# Backup files
*.bak
*.swp
*.swo
*~

# Patch files
*.patch
*.diff

# Test coverage
coverage/
.nyc_output/

# Dependency directories (if using package managers)
jspm_packages/
typings/

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

